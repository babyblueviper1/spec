{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spec/procedure-manifest.schema.json",
  "title": "Procedure Manifest",
  "description": "v0.0 (DRAFT). A signed, machine-readable adjudication procedure pinned at contract-formation time. Structural validity per this schema is necessary but NOT sufficient for arbitrability; see spec/conformance.md for conformance rules C1-C12 enforced by the reference validator.",
  "type": "object",
  "required": ["spec_version", "manifest", "parties", "engagement", "requirements", "evidence", "judge", "adjudication", "remedy", "arbitrator"],
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "type": "string",
      "description": "Version of this spec the manifest targets.",
      "const": "0.0.1"
    },
    "manifest": {
      "type": "object",
      "required": ["id", "title", "created_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 8, "description": "Globally unique manifest id (UUID recommended)." },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "parties": {
      "type": "array",
      "minItems": 2,
      "description": "Declared roles. v0.0 requires exactly one payer and exactly one payee (conformance C1). Additional attestor parties are permitted.",
      "items": {
        "type": "object",
        "required": ["role", "identity"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "enum": ["payer", "payee", "attestor"] },
          "name": { "type": "string" },
          "identity": {
            "type": "object",
            "required": ["scheme", "value"],
            "additionalProperties": false,
            "properties": {
              "scheme": {
                "type": "string",
                "enum": ["eip155-address", "erc8004-agent", "did"],
                "description": "eip155-address: chain-scoped account address. erc8004-agent: ERC-8004 identity registry reference. did: W3C DID."
              },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "engagement": {
      "type": "object",
      "required": ["deliverable_summary", "value"],
      "additionalProperties": false,
      "properties": {
        "deliverable_summary": { "type": "string", "minLength": 1, "description": "Human-readable summary. Not used in judgment; the rubric governs." },
        "value": {
          "type": "object",
          "required": ["asset", "amount"],
          "additionalProperties": false,
          "properties": {
            "asset": {
              "type": "object",
              "required": ["chain_id", "symbol"],
              "additionalProperties": false,
              "properties": {
                "chain_id": { "type": "integer", "description": "EIP-155 chain id." },
                "symbol": { "type": "string" },
                "address": { "type": "string", "description": "Token contract address; omit for native asset." }
              }
            },
            "amount": { "type": "string", "pattern": "^[0-9]+$", "description": "Integer amount in the asset's smallest unit, as a decimal string." }
          }
        },
        "deadline": { "type": "string", "format": "date-time" }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "description": "The rubric. Each item must be individually evaluable and bound to exactly one evaluation method.",
      "items": {
        "type": "object",
        "required": ["id", "title", "statement", "evaluation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1, "description": "The requirement as the judge will read it. Write for evaluability: observable, bounded, decomposed." },
          "evaluation": {
            "type": "object",
            "required": ["method"],
            "additionalProperties": false,
            "properties": {
              "method": { "type": "string", "enum": ["llm_judge", "measurement", "attestation"] },
              "judge_prompt_id": { "type": "string", "description": "Required when method=llm_judge (conformance C3). Must reference judge.prompts[].id." },
              "measurement_source_id": { "type": "string", "description": "Required when method=measurement (conformance C2). Must reference measurement_sources[].id." },
              "attestor_role_name": { "type": "string", "description": "Required when method=attestation. Must match a declared attestor party's name." },
              "pass_criteria": { "type": "string", "description": "For measurement/attestation: the machine-checkable condition (e.g. 'uptime_pct >= 99.5'). For llm_judge: optional clarifying criteria included in the judge context." }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["items", "submission_window_seconds"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "description": "The closed record. Only items declared here, submitted by declared roles, are admissible.",
          "items": {
            "type": "object",
            "required": ["id", "type", "submitter_role", "transformation", "required", "supports"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^E[0-9]+$" },
              "title": { "type": "string" },
              "type": { "type": "string", "enum": ["url", "file", "text", "metric_report"] },
              "submitter_role": { "type": "string", "enum": ["payer", "payee", "attestor"], "description": "Must correspond to a declared party (conformance C8)." },
              "transformation": {
                "type": "string",
                "enum": ["none", "render_screenshot", "extract_text"],
                "description": "Applied before the judge sees the item. render_screenshot is REQUIRED for url evidence feeding an llm_judge requirement (conformance C11): rendering strips most textual prompt injection."
              },
              "required": { "type": "boolean", "description": "If true and absent at close of submission window, the default rule applies per adjudication.on_missing_required_evidence." },
              "supports": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^R[0-9]+$" },
                "description": "Requirement ids this item is admissible for. Judges see only supporting evidence per requirement."
              },
              "max_bytes": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "submission_window_seconds": { "type": "integer", "minimum": 3600 }
      }
    },
    "measurement_sources": {
      "type": "array",
      "description": "Named doors in the closed record: the only admissible answers to factual questions.",
      "items": {
        "type": "object",
        "required": ["id", "question", "provider"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-9]+$" },
          "description": { "type": "string" },
          "question": { "type": "string", "minLength": 1, "description": "The factual question this source answers, stated precisely (units, window, method)." },
          "provider": {
            "type": "object",
            "required": ["type", "identity"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["http_api", "onchain_oracle", "named_attestor"] },
              "identity": { "type": "string", "minLength": 1, "description": "Endpoint URL, oracle contract address, or attestor identity." },
              "reading_procedure": { "type": "string", "description": "How the reading is taken (path, aggregation, sampling schedule)." }
            }
          }
        }
      }
    },
    "judge": {
      "type": "object",
      "required": ["panel", "aggregation", "sampling", "prompts"],
      "additionalProperties": false,
      "properties": {
        "panel": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "model", "runs"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^J[0-9]+$" },
              "model": {
                "type": "object",
                "required": ["name", "version", "hosting"],
                "additionalProperties": false,
                "properties": {
                  "family": { "type": "string", "description": "Model family, for heterogeneity checks across the panel." },
                  "name": { "type": "string", "minLength": 1 },
                  "version": { "type": "string", "minLength": 1, "description": "Exact version identifier. 'latest' is non-conforming by definition." },
                  "weights_hash": { "type": "string", "description": "Content hash of weights. Required when hosting=self_hosted (conformance C12)." },
                  "hosting": { "type": "string", "enum": ["self_hosted", "provider_api"] }
                }
              },
              "runs": { "type": "integer", "minimum": 1, "description": "Runs per requirement for this judge. Must be odd (conformance C4)." }
            }
          }
        },
        "aggregation": {
          "type": "object",
          "required": ["within_judge", "across_panel"],
          "additionalProperties": false,
          "properties": {
            "within_judge": { "type": "string", "enum": ["majority"] },
            "across_panel": { "type": "string", "enum": ["majority", "unanimous"], "description": "majority requires odd panel size (conformance C4)." }
          }
        },
        "sampling": {
          "type": "object",
          "required": ["temperature"],
          "additionalProperties": false,
          "properties": {
            "temperature": { "type": "number", "description": "Must be 0 in v0.0 (conformance C9)." },
            "seed_commitment": { "type": "string", "description": "Optional commitment to RNG seeds, revealed with transcripts." }
          }
        },
        "prompts": {
          "type": "array",
          "minItems": 1,
          "description": "Agreed verbatim at signing. Nothing outside these prompts, the requirement statements, and admissible evidence enters the judge context.",
          "items": {
            "type": "object",
            "required": ["id", "role", "template"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^P[0-9]+$" },
              "role": { "type": "string", "enum": ["system", "evaluation"] },
              "template": { "type": "string", "minLength": 1, "description": "May reference {{requirement.statement}}, {{requirement.pass_criteria}}, and {{evidence.<id>}} placeholders only." }
            }
          }
        },
        "fallback_ladder": {
          "type": "array",
          "description": "Ordered. Required (non-empty) if any panel model has hosting=provider_api (conformance C5).",
          "items": {
            "type": "object",
            "required": ["when", "action"],
            "additionalProperties": false,
            "properties": {
              "when": { "type": "string", "enum": ["model_unavailable", "model_deprecated"] },
              "action": { "type": "string", "enum": ["substitute", "abort_to_default_rule"] },
              "substitute": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "version": { "type": "string" },
                  "hosting": { "type": "string", "enum": ["self_hosted", "provider_api"] },
                  "weights_hash": { "type": "string" }
                },
                "description": "Required when action=substitute. Open question OQ1: equivalence semantics."
              }
            }
          }
        }
      }
    },
    "adjudication": {
      "type": "object",
      "required": ["burden_of_proof", "confidence_threshold", "default_rule", "on_missing_required_evidence", "injection_screening", "outcome_rule"],
      "additionalProperties": false,
      "properties": {
        "burden_of_proof": { "type": "string", "enum": ["payer", "payee"], "description": "The party whose claim fails when evidence is insufficient." },
        "confidence_threshold": { "type": "number", "minimum": 0.5, "maximum": 1, "description": "Per-requirement. Below threshold, the requirement resolves by default_rule. See open question OQ4." },
        "default_rule": {
          "type": "object",
          "required": ["outcome"],
          "additionalProperties": false,
          "properties": {
            "outcome": { "type": "string", "enum": ["payer", "payee", "split"] },
            "split_ratio_payer_bps": { "type": "integer", "minimum": 0, "maximum": 10000, "description": "Required when outcome=split. Basis points to payer." }
          }
        },
        "on_missing_required_evidence": { "type": "string", "enum": ["default_rule", "against_responsible_submitter"] },
        "injection_screening": {
          "type": "object",
          "required": ["enabled", "action_on_detection"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "description": "Must be true in v0.0 when any llm_judge requirement exists (conformance C10)." },
            "action_on_detection": { "type": "string", "enum": ["rule_against_submitter", "strike_evidence"] }
          }
        },
        "outcome_rule": {
          "type": "object",
          "required": ["rule"],
          "additionalProperties": false,
          "properties": {
            "rule": { "type": "string", "enum": ["all_must_pass", "weighted_threshold"] },
            "weights": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 },
              "description": "Requirement id -> weight. Required when rule=weighted_threshold."
            },
            "pass_threshold_bps": { "type": "integer", "minimum": 0, "maximum": 10000, "description": "Required when rule=weighted_threshold." }
          }
        }
      }
    },
    "remedy": {
      "type": "object",
      "required": ["structure", "ruling_map"],
      "additionalProperties": false,
      "properties": {
        "structure": { "type": "string", "enum": ["challenge_window_escrow", "streaming", "bonded_finality"] },
        "challenge_window_seconds": { "type": "integer", "minimum": 86400, "description": "Required when structure=challenge_window_escrow (conformance C6)." },
        "stream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interval_seconds": { "type": "integer", "minimum": 60 },
            "dispute_pauses_stream": { "type": "boolean", "const": true }
          },
          "description": "Required when structure=streaming."
        },
        "bond": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "posted_by": { "type": "string", "enum": ["payee", "payer", "both"] },
            "amount": { "type": "string", "pattern": "^[0-9]+$" }
          },
          "description": "Required when structure=bonded_finality."
        },
        "ruling_map": {
          "type": "object",
          "required": ["refused", "payer_wins", "payee_wins"],
          "additionalProperties": false,
          "properties": {
            "refused": { "type": "string", "enum": ["status_quo"], "description": "Ruling 0 (RefusedToArbitrate): funds follow the remedy structure's no-ruling path." },
            "payer_wins": { "type": "string", "enum": ["refund", "slash_bond_to_payer", "halt_stream_refund_balance"] },
            "payee_wins": { "type": "string", "enum": ["release", "release_and_return_bond", "resume_stream"] },
            "split": { "type": "string", "enum": ["proportional"], "description": "Only meaningful when default_rule.outcome=split or outcome_rule=weighted_threshold. Open question OQ3." }
          }
        }
      }
    },
    "arbitrator": {
      "type": "object",
      "required": ["fee", "erc792_profile"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "fee": {
          "type": "object",
          "required": ["amount", "paid_by"],
          "additionalProperties": false,
          "properties": {
            "amount": { "type": "string", "pattern": "^[0-9]+$", "description": "Same asset as engagement.value unless asset override provided." },
            "asset_symbol": { "type": "string" },
            "paid_by": { "type": "string", "enum": ["payer", "payee", "disputant", "split"] }
          }
        },
        "erc792_profile": {
          "type": "object",
          "required": ["ruling_options"],
          "additionalProperties": false,
          "properties": {
            "ruling_options": {
              "type": "array",
              "const": ["RefusedToArbitrate", "PayerWins", "PayeeWins"],
              "description": "Fixed in v0.0 to the standard ERC-792 example enum; ruling 0 is refusal."
            },
            "arbitrator_address": { "type": "string", "description": "On-chain Arbitrator contract, when deployed." },
            "meta_evidence_uri": { "type": "string", "description": "Where this manifest rides as ERC-1497 MetaEvidence." }
          }
        }
      }
    },
    "commitments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_hash_algorithm": { "type": "string", "enum": ["keccak256", "sha256"] },
        "onchain_commitment_tx": { "type": "string" },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["party_role", "signature"],
            "additionalProperties": false,
            "properties": {
              "party_role": { "type": "string", "enum": ["payer", "payee", "attestor"] },
              "signature": { "type": "string" }
            }
          }
        }
      },
      "description": "Optional in v0.0 drafts; required for a manifest to be considered executed."
    }
  }
}
